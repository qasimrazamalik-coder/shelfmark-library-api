# Copy to .env and adjust. Defaults work with `npm run db`.
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5541/shelfmark
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Circulation policy
LOAN_DAYS=14
MAX_ACTIVE_LOANS=5
MAX_RENEWALS=2
FINE_PER_DAY_CENTS=25
BLOCK_AT_FINES_CENTS=1000
HOLD_PICKUP_DAYS=3
